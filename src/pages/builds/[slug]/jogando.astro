---
import Base from '../../../layouts/Base.astro';
import PlayMode from '../../../components/PlayMode.astro';
import { getBuildVersions } from '../../../lib/site.ts';

export async function getStaticPaths() {
  const bySlug = await getBuildVersions();
  return [...bySlug.entries()].map(([slug, versions]) => ({ params: { slug }, props: { version: versions.find((v) => v.isLatest)! } }));
}
const { version } = Astro.props;
---

<Base title={`Jogando · ${version.data.meta.title}`} compact>
  <PlayMode version={version} />
</Base>
