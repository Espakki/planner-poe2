---
/**
 * Conteúdo da caixa "Equipamento" de uma fase.
 * DONO: item UI-03 do backlog (inventário estilo PoE + detalhe do item). Hoje: lista de ItemCard + notas por slot.
 */
import ItemCard from '../ItemCard.astro';
import { SLOT_PT } from '../../lib/site.ts';
import type { PhaseData } from '../../lib/schemas.ts';

interface Props {
  phase: PhaseData;
  compact?: boolean;
}
const { phase, compact = false } = Astro.props;
---

<div class="gear-panel">
  {
    phase.items.length > 0 && (
      <div class="stack">
        {phase.items.map((it) => (
          <ItemCard {...it} compact={compact} />
        ))}
      </div>
    )
  }
  {
    phase.gear.length > 0 && (
      <>
        <div class="panel-title notes-title">O que procurar por slot</div>
        <dl class="gear">
          {phase.gear.map((g) => (
            <div class="gear-row">
              <dt>{SLOT_PT[g.slot]}</dt>
              <dd>
                {g.basesEn.length > 0 && <p class="bases">{g.basesEn.join(' · ')}</p>}
                <p>{g.priorityPt.join(' › ')}</p>
                {g.notePt && <p class="gnote">{g.notePt}</p>}
              </dd>
            </div>
          ))}
        </dl>
      </>
    )
  }
</div>

<style>
  .stack {
    display: grid;
    gap: 10px;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 360px), 1fr));
    align-items: start;
  }
  .notes-title {
    margin-top: 16px;
  }
  .gear {
    margin: 0;
    display: grid;
    gap: 8px;
  }
  .gear-row {
    display: grid;
    grid-template-columns: 90px 1fr;
    gap: 10px;
    padding: 8px 10px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: rgb(0 0 0 / 0.18);
  }
  .gear dt {
    font-weight: 700;
    color: var(--acc-gear);
  }
  .gear dd {
    margin: 0;
    color: var(--text-2);
  }
  .bases {
    color: var(--normal);
    font-size: 0.88rem;
  }
  .gnote {
    color: var(--muted);
    font-size: 0.86rem;
    margin-top: 2px;
  }
  @media (max-width: 560px) {
    .gear-row {
      grid-template-columns: 1fr;
      gap: 2px;
    }
  }
</style>
