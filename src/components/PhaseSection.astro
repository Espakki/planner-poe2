---
import GemGroup from './GemGroup.astro';
import ItemCard from './ItemCard.astro';
import AscendancyStep from './AscendancyStep.astro';
import TreeSummary from './TreeSummary.astro';
import Checklist from './Checklist.astro';
import { SLOT_PT } from '../lib/site.ts';
import type { BuildData, PhaseData } from '../lib/schemas.ts';
import type { ResolvedPhaseTree } from '../lib/build-tree.ts';

interface Props {
  phase: PhaseData;
  index: number;
  build: BuildData;
  tree?: ResolvedPhaseTree;
  /** Modo jogando: só o essencial, sem resumos longos. */
  compact?: boolean;
}
const { phase, index, build, tree, compact = false } = Astro.props;
const source = build.meta.sources.find((s) => s.id === phase.source);
const filter = build.filter.find((f) => f.id === phase.filter);
---

<section class:list={['phase', { compact }]} id={`fase-${phase.id}`} data-phase-section={phase.id}>
  <header class="ph-head">
    <div class="ph-badge">
      <span class="num">{index + 1}</span>
      <span class="lv">Lv {phase.levels[0]}–{phase.levels[1]}</span>
    </div>
    <div class="ph-titles">
      {phase.stagePt && <p class="stage">{phase.stagePt}</p>}
      <h2>{phase.title}</h2>
      {
        source && !compact && (
          <p class="src small muted">
            Fonte: <a href={source.url} target="_blank" rel="noopener">{source.author ?? source.label}</a>
          </p>
        )
      }
    </div>
    <div class="ph-actions">
      <button type="button" class="btn ghost here" data-set-phase={phase.id} aria-pressed="false">
        <span class="on-label">● Fase atual</span><span class="off-label">Estou aqui</span>
      </button>
      {tree && !compact && <a class="btn ghost" href="#arvore" data-show-tree={phase.id}>Ver na árvore</a>}
    </div>
  </header>

  <p class="summary">{phase.summaryPt}</p>

  {
    phase.goalsPt.length > 0 && (
      <ul class="goals">
        {phase.goalsPt.map((g) => (
          <li>{g}</li>
        ))}
      </ul>
    )
  }

  <div class="grid">
    <div class="col-main">
      <div class="block">
        <div class="panel-title">Gemas</div>
        <div class="stack">
          {phase.skills.map((s) => <GemGroup setup={s} compact={compact} />)}
        </div>
      </div>
      {
        phase.spirit.length > 0 && (
          <div class="block">
            <div class="panel-title">Spirit / auras</div>
            <div class="stack">
              {phase.spirit.map((s) => (
                <GemGroup setup={s} compact={compact} />
              ))}
            </div>
          </div>
        )
      }
      {
        (phase.howToPlayPt.length > 0 || phase.bossingPt.length > 0) && (
          <div class="block play">
            {phase.howToPlayPt.length > 0 && (
              <>
                <div class="panel-title">Como jogar</div>
                <ul>
                  {phase.howToPlayPt.map((t) => (
                    <li>{t}</li>
                  ))}
                </ul>
              </>
            )}
            {phase.bossingPt.length > 0 && (
              <>
                <div class="panel-title boss">Chefes</div>
                <ol>
                  {phase.bossingPt.map((t) => (
                    <li>{t}</li>
                  ))}
                </ol>
              </>
            )}
          </div>
        )
      }
    </div>

    <div class="col-side">
      {phase.ascendancy && <AscendancyStep step={phase.ascendancy} compact={compact} />}

      {
        phase.items.length > 0 && (
          <div class="block">
            <div class="panel-title">Itens</div>
            <div class="stack">
              {phase.items.map((it) => (
                <ItemCard {...it} compact={compact} />
              ))}
            </div>
          </div>
        )
      }

      {
        phase.gear.length > 0 && (
          <div class="block">
            <div class="panel-title">Equipamento — o que procurar</div>
            <dl class="gear">
              {phase.gear.map((g) => (
                <div class="gear-row">
                  <dt>{SLOT_PT[g.slot]}</dt>
                  <dd>
                    {g.basesEn.length > 0 && <p class="bases">{g.basesEn.join(' · ')}</p>}
                    <p>{g.priorityPt.join(' › ')}</p>
                    {g.notePt && <p class="gnote">{g.notePt}</p>}
                  </dd>
                </div>
              ))}
            </dl>
          </div>
        )
      }

      {
        tree && (
          <div class="block">
            <div class="panel-title">Árvore desta fase</div>
            <TreeSummary tree={tree} notesPt={phase.treeNotesPt} compact={compact} />
          </div>
        )
      }

      {
        filter && (
          <p class="filter">
            Filtro: <strong>NeverSink {filter.strictness}</strong> <span class="muted">({filter.stagePt})</span>
          </p>
        )
      }

      {phase.checklist.length > 0 && <Checklist group={phase.id} items={phase.checklist} title="Checklist da fase" />}
    </div>
  </div>
</section>

<style>
  .phase {
    padding: 22px 0 30px;
    border-top: 1px solid var(--border);
  }
  .ph-head {
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: 12px;
    align-items: center;
  }
  .ph-badge {
    display: grid;
    place-items: center;
    width: 64px;
    height: 64px;
    border: 1px solid var(--bronze);
    border-radius: 50%;
    background: radial-gradient(circle at 50% 30%, #2c2318, #120f0b);
    text-align: center;
  }
  .ph-badge .num {
    font-family: var(--font-display);
    font-size: 1.3rem;
    color: var(--bronze-hi);
    line-height: 1;
  }
  .ph-badge .lv {
    font-size: 0.62rem;
    color: var(--muted);
    white-space: nowrap;
  }
  .stage {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--bronze);
  }
  .ph-titles h2 {
    font-size: clamp(1.15rem, 3.2vw, 1.6rem);
  }
  .ph-actions {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
    justify-content: flex-end;
  }
  .here .on-label {
    display: none;
    color: var(--new);
  }
  .here[aria-pressed='true'] .on-label {
    display: inline;
  }
  .here[aria-pressed='true'] .off-label {
    display: none;
  }
  .here[aria-pressed='true'] {
    border-color: color-mix(in srgb, var(--new) 50%, var(--border-2));
  }
  .summary {
    margin-top: 14px;
    font-size: 1rem;
    color: var(--text);
    max-width: 85ch;
  }
  .goals {
    margin-top: 10px;
    display: grid;
    gap: 3px;
    color: var(--text-2);
    max-width: 85ch;
  }
  .goals li::marker {
    color: var(--bronze);
  }
  .grid {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
    gap: 20px;
    margin-top: 18px;
    align-items: start;
  }
  .col-main,
  .col-side {
    display: grid;
    gap: 18px;
    min-width: 0;
  }
  .stack {
    display: grid;
    gap: 10px;
  }
  .play ul,
  .play ol {
    display: grid;
    gap: 4px;
    color: var(--text-2);
    margin-bottom: 12px;
  }
  .panel-title.boss {
    margin-top: 6px;
  }
  .gear {
    margin: 0;
    display: grid;
    gap: 8px;
  }
  .gear-row {
    display: grid;
    grid-template-columns: 82px 1fr;
    gap: 10px;
    padding: 8px 10px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: rgb(0 0 0 / 0.18);
  }
  .gear dt {
    font-weight: 600;
    color: var(--bronze-hi);
    font-size: 0.88rem;
  }
  .gear dd {
    margin: 0;
    font-size: 0.88rem;
    color: var(--text-2);
  }
  .bases {
    color: var(--normal);
    font-size: 0.82rem;
  }
  .gnote {
    color: var(--muted);
    font-size: 0.8rem;
    margin-top: 2px;
  }
  .filter {
    font-size: 0.9rem;
    color: var(--text-2);
  }
  @media (max-width: 900px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 560px) {
    .ph-head {
      grid-template-columns: auto 1fr;
    }
    .ph-actions {
      grid-column: 1 / -1;
      justify-content: flex-start;
    }
    .ph-badge {
      width: 54px;
      height: 54px;
    }
    .gear-row {
      grid-template-columns: 1fr;
      gap: 2px;
    }
  }
</style>
