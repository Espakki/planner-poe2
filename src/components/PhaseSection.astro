---
/**
 * Uma fase da build. Layout:
 *   cabeçalho (nº, níveis, ato, título, ações) → resumo + objetivos →
 *   caixas que abrem/fecham: Skills · Equipamento · Árvore & Ascendência · Como jogar · Checklist
 * O conteúdo de cada caixa mora em components/phase/* (cada um com dono no backlog).
 */
import SkillsPanel from './phase/SkillsPanel.astro';
import GearPanel from './phase/GearPanel.astro';
import TreePanel from './phase/TreePanel.astro';
import Checklist from './Checklist.astro';
import type { BuildData, PhaseData } from '../lib/schemas.ts';
import type { ResolvedPhaseTree } from '../lib/build-tree.ts';

interface Props {
  phase: PhaseData;
  index: number;
  build: BuildData;
  tree?: ResolvedPhaseTree;
  /** Modo jogando: só o essencial, sem resumos longos. */
  compact?: boolean;
}
const { phase, index, build, tree, compact = false } = Astro.props;
const source = build.meta.sources.find((s) => s.id === phase.source);
const filter = build.filter.find((f) => f.id === phase.filter);
const skillCount = phase.skills.length;
const spiritCount = phase.spirit.length;
const reqItems = phase.items.filter((i) => i.required).length;
const hasPlay = phase.howToPlayPt.length > 0 || phase.bossingPt.length > 0;
---

<section class:list={['phase', { compact }]} id={`fase-${phase.id}`} data-phase-section={phase.id}>
  <header class="ph-head">
    <div class="ph-badge" aria-hidden="true">
      <span class="num">{index + 1}</span>
    </div>
    <div class="ph-titles">
      <p class="stage">
        {phase.stagePt && <span>{phase.stagePt}</span>}
        <span class="lv">Nível {phase.levels[0]}–{phase.levels[1]}</span>
      </p>
      <h2>{phase.title}</h2>
    </div>
    <div class="ph-actions">
      <button type="button" class="btn ghost here" data-set-phase={phase.id} aria-pressed="false">
        <span class="on-label">● Fase atual</span><span class="off-label">Estou aqui</span>
      </button>
    </div>
  </header>

  <div class:list={['intro', { 'no-goals': phase.goalsPt.length === 0 }]}>
    <div class="summary">
      <p>{phase.summaryPt}</p>
      {
        !compact && (source || filter) && (
          <p class="meta small">
            {source && (
              <>
                Fonte:{' '}
                <a href={source.url} target="_blank" rel="noopener">
                  {source.author ?? source.label}
                </a>
              </>
            )}
            {source && filter && ' · '}
            {filter && (
              <>
                Filtro: <strong>NeverSink {filter.strictness}</strong>
              </>
            )}
          </p>
        )
      }
    </div>
    {
      phase.goalsPt.length > 0 && (
        <div class="goals">
          <p class="goals-title">Objetivos</p>
          <ul>
            {phase.goalsPt.map((g) => (
              <li>{g}</li>
            ))}
          </ul>
        </div>
      )
    }
  </div>

  <div class="boxes">
    <details class="box box--skills b-wide" open data-box="skills">
      <summary>
        <span class="box-title">Skills</span>
        <span class="box-meta">{skillCount} skill{skillCount === 1 ? '' : 's'}{spiritCount > 0 && ` · ${spiritCount} aura${spiritCount === 1 ? '' : 's'}`}</span>
      </summary>
      <div class="box-body"><SkillsPanel phase={phase} compact={compact} /></div>
    </details>

    {
      (phase.items.length > 0 || phase.gear.length > 0) && (
        <details class="box box--gear b-wide" open data-box="gear">
          <summary>
            <span class="box-title">Equipamento</span>
            <span class="box-meta">
              {phase.items.length} ite{phase.items.length === 1 ? 'm' : 'ns'}
              {reqItems > 0 && ` · ${reqItems} obrigatório${reqItems === 1 ? '' : 's'}`}
            </span>
          </summary>
          <div class="box-body">
            <GearPanel phase={phase} compact={compact} />
          </div>
        </details>
      )
    }

    {
      (tree || phase.ascendancy) && (
        <details class="box box--tree" open data-box="tree">
          <summary>
            <span class="box-title">Árvore & Ascendência</span>
            {tree && (
              <span class="box-meta">
                +{tree.added.length} nodes{tree.removed.length > 0 && ` · respec −${tree.removed.length}`}
                {phase.ascendancy && ' · ascensão'}
              </span>
            )}
          </summary>
          <div class="box-body">
            <TreePanel phase={phase} tree={tree} compact={compact} showTreeLink={!compact} />
          </div>
        </details>
      )
    }

    <div class="side-stack">
      {
        hasPlay && (
          <details class="box box--play" open data-box="play">
            <summary>
              <span class="box-title">Como jogar</span>
              {phase.bossingPt.length > 0 && <span class="box-meta">+ chefes</span>}
            </summary>
            <div class="box-body play">
              {phase.howToPlayPt.length > 0 && (
                <ul>
                  {phase.howToPlayPt.map((t) => (
                    <li>{t}</li>
                  ))}
                </ul>
              )}
              {phase.bossingPt.length > 0 && (
                <>
                  <p class="sub">Chefes</p>
                  <ol>
                    {phase.bossingPt.map((t) => (
                      <li>{t}</li>
                    ))}
                  </ol>
                </>
              )}
            </div>
          </details>
        )
      }
      {
        phase.checklist.length > 0 && (
          <details class="box box--check" open data-box="check">
            <summary>
              <span class="box-title">Checklist</span>
              <span class="box-meta" data-check-count={phase.id}>
                0/{phase.checklist.length}
              </span>
            </summary>
            <div class="box-body">
              <Checklist group={phase.id} items={phase.checklist} title="" bare />
            </div>
          </details>
        )
      }
    </div>
  </div>
</section>

<style>
  .phase {
    padding: 26px 0 34px;
    border-top: 1px solid var(--border);
  }
  .ph-head {
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: 14px;
    align-items: center;
  }
  .ph-badge {
    display: grid;
    place-items: center;
    width: 54px;
    height: 54px;
    border: 1px solid var(--bronze);
    border-radius: 50%;
    background: radial-gradient(circle at 50% 30%, #30261a, #120f0b);
    box-shadow: 0 0 0 3px rgb(176 141 85 / 0.12);
  }
  .ph-badge .num {
    font-family: var(--font-display);
    font-weight: var(--display-weight);
    font-size: 1.5rem;
    color: var(--bronze-hi);
    line-height: 1;
  }
  .stage {
    display: flex;
    flex-wrap: wrap;
    gap: 2px 12px;
    font-size: 0.84rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--bronze);
  }
  .stage .lv {
    color: var(--muted);
  }
  .ph-titles h2 {
    font-size: clamp(1.35rem, 3.4vw, 1.9rem);
    margin-top: 2px;
  }
  .ph-actions {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
    justify-content: flex-end;
  }
  .here .on-label {
    display: none;
    color: var(--new);
  }
  .here[aria-pressed='true'] .on-label {
    display: inline;
  }
  .here[aria-pressed='true'] .off-label {
    display: none;
  }
  .here[aria-pressed='true'] {
    border-color: color-mix(in srgb, var(--new) 50%, var(--border-2));
  }

  .intro {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
    gap: 16px;
    margin-top: 16px;
  }
  .intro.no-goals {
    grid-template-columns: 1fr;
  }
  .summary > p:first-child {
    font-size: 1.06rem;
    color: var(--text);
    max-width: 75ch;
  }
  .meta {
    margin-top: 8px;
    color: var(--muted);
  }
  .goals {
    padding: 10px 14px;
    border-left: 2px solid var(--bronze);
    background: rgb(176 141 85 / 0.06);
    border-radius: 0 var(--radius) var(--radius) 0;
  }
  .goals-title {
    font-family: var(--font-display);
    font-weight: var(--display-weight);
    color: var(--bronze-hi);
    letter-spacing: 0.04em;
    margin-bottom: 4px;
  }
  .goals ul {
    display: grid;
    gap: 3px;
    color: var(--text-2);
  }
  .goals li::marker {
    color: var(--bronze);
  }

  .boxes {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
    gap: 14px;
    margin-top: 18px;
    align-items: start;
  }
  .b-wide {
    grid-column: 1 / -1;
  }
  .side-stack {
    display: grid;
    gap: 14px;
    min-width: 0;
  }
  .play ul,
  .play ol {
    display: grid;
    gap: 5px;
    color: var(--text-2);
  }
  .play .sub {
    margin: 12px 0 4px;
    font-family: var(--font-display);
    font-weight: var(--display-weight);
    color: var(--acc-play);
  }

  .compact .intro {
    grid-template-columns: 1fr;
  }

  @media (max-width: 900px) {
    .boxes,
    .intro {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 560px) {
    .ph-head {
      grid-template-columns: auto 1fr;
    }
    .ph-actions {
      grid-column: 1 / -1;
      justify-content: flex-start;
    }
    .ph-badge {
      width: 46px;
      height: 46px;
    }
  }
</style>
