---
/**
 * Modo jogando: uma tela compacta só com a fase atual (salva no navegador).
 * No fim, a caixa "Árvore desta fase" com a árvore interativa (uma instância só) acompanhando o seletor de fase.
 */
import PhaseSection from './PhaseSection.astro';
import TreeViewer from './TreeViewer.astro';
import { getPhaseTrees, url, type BuildVersion } from '../lib/site.ts';

interface Props {
  version: BuildVersion;
}
const { version } = Astro.props;
const b = version.data;
const m = b.meta;
const trees = await getPhaseTrees(b);
const treeOf = new Map(trees.map((t) => [t.phaseId, t]));
const stateKey = `${m.slug}@${m.patch}`;
const fullUrl = url(`builds/${m.slug}/${version.isLatest ? '' : `${m.patch}/`}`);
const firstPhase = b.phases[0]?.id;
/** Resumo da árvore da fase no título da caixa (visível mesmo com ela fechada). */
const treeMeta = (t: (typeof trees)[number], i: number) => {
  if (t.error) return 'sem árvore';
  if (i === 0) return `${t.mainPoints} pontos`;
  return `+${t.added.length} novos${t.removed.length > 0 ? ` · respec −${t.removed.length}` : ''}`;
};
---

<div class="play wrap" data-play={stateKey}>
  <div class="bar">
    <a class="back small" href={fullUrl}>← guia completo</a>
    <span class="small muted">{m.title} · {m.patch}</span>
  </div>
  <div class="picker">
    <button type="button" class="btn ghost nav" data-step="-1" aria-label="Fase anterior">‹</button>
    <label class="sel">
      <span class="visually-hidden">Fase</span>
      <select data-phase-select>
        {
          b.phases.map((p, i) => (
            <option value={p.id}>
              {i + 1} · {(p.stagePt ?? p.title).split(' · ')[0]} ({p.levels[0]}–{p.levels[1]})
            </option>
          ))
        }
      </select>
    </label>
    <button type="button" class="btn ghost nav" data-step="1" aria-label="Próxima fase">›</button>
    {
      trees.length > 0 && (
        <button type="button" class="btn tree-btn" data-goto-tree aria-label="Abrir a árvore desta fase" title="Árvore desta fase">
          <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
            <circle cx="6" cy="6" r="2.4" fill="currentColor" />
            <circle cx="18" cy="8" r="2.4" fill="currentColor" />
            <circle cx="12" cy="18" r="2.4" fill="currentColor" />
            <path d="M6 6 18 8M6 6l6 12M18 8l-6 10" stroke="currentColor" stroke-width="1.6" fill="none" />
          </svg>
          <span class="lbl">Árvore</span>
        </button>
      )
    }
    <button type="button" class="btn ghost wake" data-wake aria-pressed="false" aria-label="Manter a tela ligada" title="Impede a tela de apagar (celular)">
      ☀<span class="lbl"> Tela ligada</span>
    </button>
  </div>

  {
    b.phases.map((p, i) => (
      <div class="ph" data-play-phase={p.id} hidden={i !== 0}>
        <PhaseSection phase={p} index={i} build={b} tree={treeOf.get(p.id)} compact />
      </div>
    ))
  }

  {
    /* Depois do conteúdo da fase: é o que se consulta menos durante o jogo, e o canvas prende o toque
       (arrastar = mover a árvore) — no meio da página atrapalharia rolar no celular. */
    trees.length > 0 && (
      <details class="box box--tree play-tree" open data-box="tree-play">
        <summary>
          <span class="box-title">Árvore desta fase</span>
          {trees.map((t, i) => (
            <span class="box-meta" data-tree-meta={t.phaseId} hidden={t.phaseId !== firstPhase}>
              {treeMeta(t, i)}
            </span>
          ))}
        </summary>
        <div class="box-body">
          <TreeViewer
            embedded
            phaseButtons={false}
            load="visible"
            treeVersion={m.treeVersion}
            ascendancy={m.ascendancy}
            className={m.class}
            phases={trees}
            stateKey={stateKey}
            initialPhase={firstPhase}
          />
        </div>
      </details>
    )
  }
</div>

<script>
  import { bindChecklists, loadState, update } from '../scripts/state.ts';
  import { bindBoxes } from '../scripts/boxes.ts';

  const root = document.querySelector<HTMLElement>('[data-play]');
  if (root) {
    const build = root.dataset.play!;
    const select = root.querySelector<HTMLSelectElement>('[data-phase-select]')!;
    const ids = [...select.options].map((o) => o.value);
    bindChecklists(build, root);
    bindBoxes(root);

    const show = (id: string, save = true) => {
      if (!ids.includes(id)) id = ids[0];
      select.value = id;
      for (const el of root.querySelectorAll<HTMLElement>('[data-play-phase]')) el.hidden = el.dataset.playPhase !== id;
      for (const el of root.querySelectorAll<HTMLElement>('[data-tree-meta]')) el.hidden = el.dataset.treeMeta !== id;
      for (const b of root.querySelectorAll<HTMLButtonElement>('[data-set-phase]')) b.setAttribute('aria-pressed', String(b.dataset.setPhase === id));
      if (save) update(build, (s) => (s.phase = id));
    };
    show(loadState(build).phase ?? ids[0], false);

    select.addEventListener('change', () => show(select.value));
    for (const b of root.querySelectorAll<HTMLButtonElement>('[data-step]')) {
      b.addEventListener('click', () => {
        const i = ids.indexOf(select.value) + Number(b.dataset.step);
        if (i >= 0 && i < ids.length) {
          show(ids[i]);
          window.scrollTo({ top: 0 });
        }
      });
    }
    // Botão "Árvore" da barra: abre a caixa da árvore e vai até ela; no celular já entra em tela cheia
    root.querySelector<HTMLButtonElement>('[data-goto-tree]')?.addEventListener('click', () => {
      const box = root.querySelector<HTMLDetailsElement>('details[data-box="tree-play"]');
      if (!box) return;
      box.open = true;
      if (window.matchMedia('(max-width: 640px)').matches) {
        const full = box.querySelector<HTMLButtonElement>('[data-fullscreen]');
        if (full && full.getAttribute('aria-pressed') !== 'true') full.click();
      } else {
        box.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
    });

    // "Estou aqui" dentro da fase só confirma a fase
    root.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-set-phase]');
      if (btn) show(btn.dataset.setPhase!);
    });

    // Wake Lock: mantém a tela acesa no celular enquanto joga
    const wakeBtn = root.querySelector<HTMLButtonElement>('[data-wake]')!;
    type Sentinel = { release(): Promise<void>; addEventListener(t: string, f: () => void): void };
    const nav = navigator as Navigator & { wakeLock?: { request(t: 'screen'): Promise<Sentinel> } };
    let sentinel: Sentinel | null = null;
    if (!nav.wakeLock) wakeBtn.hidden = true;
    const lock = async () => {
      try {
        sentinel = await nav.wakeLock!.request('screen');
        wakeBtn.setAttribute('aria-pressed', 'true');
        sentinel.addEventListener('release', () => wakeBtn.setAttribute('aria-pressed', 'false'));
      } catch {
        wakeBtn.setAttribute('aria-pressed', 'false');
      }
    };
    wakeBtn.addEventListener('click', async () => {
      if (sentinel) {
        await sentinel.release();
        sentinel = null;
      } else await lock();
    });
    document.addEventListener('visibilitychange', () => {
      if (document.visibilityState === 'visible' && wakeBtn.getAttribute('aria-pressed') === 'true') void lock();
    });
  }
</script>

<style>
  .play {
    padding-top: 10px;
  }
  .bar {
    display: flex;
    justify-content: space-between;
    gap: 8px;
    align-items: baseline;
  }
  .picker {
    position: sticky;
    top: 52px;
    z-index: 20;
    display: flex;
    gap: 6px;
    align-items: center;
    padding: 8px 0;
    background: rgb(11 10 8 / 0.94);
    backdrop-filter: blur(8px);
  }
  .sel {
    flex: 1;
    min-width: 0;
  }
  .sel select {
    width: 100%;
    min-height: 40px;
    padding: 6px 10px;
    border: 1px solid var(--bronze);
    border-radius: var(--radius);
    background: var(--panel-2);
    color: var(--bronze-hi);
    font-family: var(--font-display);
    font-size: 0.95rem;
  }
  .nav {
    width: 40px;
    min-height: 40px;
    padding: 0;
    font-size: 1.4rem;
    font-family: var(--font-body);
  }
  .wake[aria-pressed='true'] {
    color: var(--new);
  }
  .tree-btn {
    min-height: 40px;
    padding: 0 12px;
    color: var(--acc-tree);
    border-color: color-mix(in srgb, var(--acc-tree) 45%, var(--border-2));
  }
  .ph :global(.phase) {
    border-top: 0;
    padding-top: 8px;
  }
  .play-tree {
    margin-bottom: 24px;
  }
  @media (max-width: 560px) {
    .picker {
      gap: 4px;
    }
    .wake {
      width: 40px;
      min-height: 40px;
      padding: 0;
      font-family: var(--font-body);
    }
    .wake .lbl {
      display: none;
    }
    .tree-btn {
      padding: 0 10px;
    }
  }
  @media (max-width: 380px) {
    .tree-btn .lbl {
      display: none;
    }
    .tree-btn {
      width: 40px;
      padding: 0;
    }
  }
</style>
