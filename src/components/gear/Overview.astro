---
/**
 * Resumo por slot, embaixo do boneco: o que vai em cada slot (item na cor da raridade + alternativas)
 * ou o que procurar (bases › prioridades › nota). Substitui a antiga lista "O que procurar por slot".
 * Cada linha abre o mesmo detalhe que o slot do boneco.
 */
import { SLOT_PT } from '../../lib/site.ts';
import { rarityOf, type Inventory } from './inventory.ts';

interface Props {
  inv: Inventory;
  uid: string;
}
const { inv, uid } = Astro.props;
---

{
  inv.groups.length > 0 && (
    <ul class="ov" aria-label="Resumo por slot">
      {inv.groups.map((g) => {
        const multiSlot = new Set(g.notes.map((n) => n.slot)).size > 1;
        return (
          <li>
            <button type="button" class="ov-row" data-gear-open={g.def.key} aria-controls={`${uid}-d-${g.def.key}`}>
              <span class:list={['ov-slot', g.def.key === 'ws2' && 'w2', g.def.key === 'ws1' && 'w1']}>{g.def.label}</span>
              <span class="ov-main">
                {g.primaries.length > 0 && (
                  <span class="ov-items">
                    {g.primaries.map((p) => (
                      <span class={`game-name c-${rarityOf(p.item)}`}>
                        {p.item.nameEn}
                        {p.pi.required && (
                          <b class="ov-req" title="obrigatório">
                            ◆
                          </b>
                        )}
                      </span>
                    ))}
                    {g.alts.length > 0 && <span class="ov-alt">ou {g.alts.map((p) => p.item.nameEn).join(' · ')}</span>}
                  </span>
                )}
                {g.notes.map((n) => (
                  <span class="ov-hint">
                    <span class="ov-tag">{multiSlot ? SLOT_PT[n.slot] : 'Procurar'}</span>
                    {n.basesEn.length > 0 && <span class="ov-bases">{n.basesEn.join(' · ')}</span>}
                    <span class="ov-prio">{n.priorityPt.join(' › ')}</span>
                    {n.notePt && <span class="ov-note">{n.notePt}</span>}
                  </span>
                ))}
              </span>
              <span class="ov-go" aria-hidden="true">
                ›
              </span>
            </button>
          </li>
        );
      })}
    </ul>
  )
}

<style>
  .ov {
    list-style: none;
    padding: 0;
    margin: 12px 0 0;
    display: grid;
    gap: 4px;
  }
  .ov-row {
    display: grid;
    grid-template-columns: 6.6em minmax(0, 1fr) auto;
    gap: 10px;
    align-items: start;
    width: 100%;
    min-height: 40px;
    padding: 7px 10px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: rgb(0 0 0 / 0.18);
    color: var(--text-2);
    text-align: left;
    cursor: pointer;
  }
  .ov-row:hover {
    border-color: var(--border-2);
    background: rgb(0 0 0 / 0.28);
  }
  .ov-row[aria-current='true'] {
    border-color: color-mix(in srgb, var(--bronze-hi) 70%, transparent);
    background: rgb(227 194 134 / 0.06);
  }
  .ov-slot {
    font-family: var(--font-display);
    font-weight: var(--display-weight);
    font-size: 0.9rem;
    letter-spacing: 0.03em;
    color: var(--acc-gear);
    padding-top: 0.08em;
  }
  .ov-slot.w1 {
    color: var(--ws1);
  }
  .ov-slot.w2 {
    color: var(--ws2);
  }
  .ov-main {
    display: grid;
    gap: 3px;
    min-width: 0;
  }
  .ov-items {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0 10px;
  }
  .c-normal {
    color: var(--text);
  }
  .ov-req {
    margin-left: 4px;
    color: var(--warn);
    font-size: 0.7em;
    vertical-align: 0.15em;
  }
  .ov-alt {
    color: var(--muted);
    font-size: 0.86rem;
  }
  .ov-hint {
    display: block;
    font-size: 0.88rem;
    line-height: 1.4;
  }
  .ov-tag {
    margin-right: 6px;
    color: var(--muted);
    font-size: 0.74rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  .ov-bases {
    color: var(--normal);
    font-family: var(--font-item);
  }
  .ov-bases::after {
    content: ' — ';
    color: var(--faint);
    font-family: var(--font-body);
  }
  .ov-note {
    display: block;
    color: var(--muted);
    font-size: 0.84rem;
  }
  .ov-go {
    color: var(--faint);
    font-size: 1.2rem;
    line-height: 1;
  }
  @container gear (max-width: 420px) {
    .ov-row {
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 2px 8px;
    }
    .ov-slot {
      grid-column: 1;
    }
    .ov-main {
      grid-column: 1;
    }
    .ov-go {
      grid-column: 2;
      grid-row: 1 / span 2;
      align-self: center;
    }
  }
</style>
